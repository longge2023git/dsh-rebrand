# Local relay settings. Copy to .env and fill in; .env is gitignored.
# Public origin the browser and DSH reach. Loopback HTTP is allowed by DSH only
# with allowLoopbackHttp: true in its profile patch.
PUBLIC_ORIGIN=http://127.0.0.1:18082
PORT=18082

# New API container (see docker-compose.yml).
NEWAPI_BASE_URL=http://127.0.0.1:13000
# New API-issued key (sk-...) used by the relay for inference. Not the upstream key.
NEWAPI_KEY=

# Where the SQLite database lives.
DATA_DIR=./data

# Signing secret for browser sessions and CSRF tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# Account token lifetime, days.
TOKEN_TTL_DAYS=30

# Product name shown on the relay's login and completion pages.
BRAND_NAME=DSH Relay

# Exposed models. `upstream` is the model id sent to New API; omit when identical.
# MODELS=[{"id":"deepseek-flash","name":"DeepSeek Flash","context_window":1000000,"max_output_tokens":256000,"image":true},{"id":"deepseek-v4-pro","name":"DeepSeek V4 Pro","context_window":1000000,"max_output_tokens":256000}]
MODELS=[{"id":"deepseek-flash","name":"DeepSeek Flash","context_window":1000000,"max_output_tokens":256000,"image":true},{"id":"deepseek-v4-pro","name":"DeepSeek V4 Pro","context_window":1000000,"max_output_tokens":256000}]

# Allow new accounts from the login page.
ALLOW_REGISTRATION=true

# Optional: a proxy reachable from the New API container. The host loopback
# address is not reachable from a container; forward it to the host LAN IP or
# use a proxy container.
# HTTP_PROXY=http://192.168.1.10:10809
# HTTPS_PROXY=http://192.168.1.10:10809
# NO_PROXY=localhost,127.0.0.1,new-api

# NewAPI image (patched fork) and the Anthropic channel used for Files API.
# NEWAPI_IMAGE=new-api-deepseek:dev
# FILE_CHANNEL_ID=1
